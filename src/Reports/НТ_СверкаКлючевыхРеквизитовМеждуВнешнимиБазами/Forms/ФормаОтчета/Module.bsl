Функция ЗаполнитьПравилаИспользованияПолейПоУмолчанию(ТТ, ТекущийПараметрОбменаНСИ)
	
	мСписокВнешнихИнформационныхБаз = СписокВнешнихИнформационныхБаз.Выгрузить().Скопировать(Новый Структура("Выбран", Истина));
    мСписокВнешнихИнформационныхБаз.Свернуть("ТипБД");
	Для Каждого ЭлеменСписка Из мСписокВнешнихИнформационныхБаз Цикл 
		
		Макет = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("Правила_" + ТекущийПараметрОбменаНСИ + "_" + ЭлеменСписка.ТипБД);
		ПостроительЗапроса = Новый ПостроительЗапроса;
		ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область());
		ПостроительЗапроса.Выполнить();
		ТаблицаРезультат_0 = ПостроительЗапроса.Результат.Выгрузить();
		
		Для Каждого м Из ТаблицаРезультат_0.Скопировать(Новый Структура("Выбран", "Истина")) Цикл 
			т = ТТ.Добавить();
			ЗаполнитьЗначенияСвойств(т, м);
			т.ТипБД = Справочники.ТипыБазДанных.НайтиПоНаименованию(ЭлеменСписка.ТипБД);
			т.Выбран = ?(м.Выбран= "Истина", Истина, Ложь);
			т.КлючевоеПоле = ?(м.КлючевоеПоле= "Истина", Истина, Ложь);
		КонецЦикла;	 
	КонецЦикла;	 
	
	Возврат ТТ;
