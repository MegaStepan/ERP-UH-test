&НаКлиенте
Процедура РезультатГлавноеОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	СтандартнаяОбработка = Ложь;
	Действия_ = Новый СписокЗначений;
	Если Лев(Расшифровка, 10) = "e1cib/data" Тогда 
		Действия_.Добавить("ПоказатьСсылку", "Показать ссылку", , БиблиотекаКартинок.СкопироватьОбъект); 
	ИначеЕсли Лев(Расшифровка, 1) = "#" Тогда 
		мРасшифровка = СтрРазделить(Сред(Расшифровка, 2), ";");
	//	Расшифровка = мРасшифровка[0];
		Если Не мРасшифровка[0] = "Текущая информационная база" Тогда 
			Действия_.Добавить("СоздатьОбъектВЭтойБД", "Создать объект из этой БД", , БиблиотекаКартинок.СкопироватьОбъект); 
			Если мРасшифровка[1] = "Нет" Тогда 
				Действия_.Добавить("СвязатьЭлементСЭтойБД", "Связать элемент с этой БД", , БиблиотекаКартинок.ПолучитьНавигационнуюСсылку);			
			КонецЕсли;                                                
		КонецЕсли;
	КонецЕсли;	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ОписаниеОповещенияОЗакрытии", ЭтотОбъект, Расшифровка);		
	ПоказатьВыборИзМеню(ОписаниеОповещенияОЗакрытии, Действия_, Элемент);
	//7702232171
	//770201001
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеОповещенияОЗакрытии(ВыбранныйЭлемент, Расшифровка) Экспорт

	мРасшифровка = СтрРазделить(Сред(Расшифровка, 2), ";");
	ВнешняяИБ = ПолучитьВнешняяИБПоИмени(мРасшифровка[0]);
	Если ВыбранныйЭлемент = Неопределено Тогда
    ИначеЕсли ВыбранныйЭлемент.Значение = "ПоказатьСсылку" Тогда
       Сообщить(Расшифровка);
   	ИначеЕсли ВыбранныйЭлемент.Значение = "СоздатьОбъектВЭтойБД" Тогда
		НайденОбъектВнешнейБДПоСсылке = Ложь;
//		ВнешниеБД_СнятьОтметитьВсе(Команды.ВнешниеБД_ОтменитьВсе, Ложь, ВнешняяИБ);
		ВнешниеБД_СнятьОтметитьВсе("ВнешниеБД_ОтменитьВсе", Ложь, ВнешняяИБ);
	//	СформироватьОтчет_ПоРеквизитам(Истина); 
		СформироватьОтчет_ПоGUID(ВнешняяИБ, мРасшифровка[2], НайденОбъектВнешнейБДПоСсылке, Истина); 
		СоздатьОбъектВЭтойБД(ВнешняяИБ);
   	ИначеЕсли ВыбранныйЭлемент.Значение = "СвязатьЭлементСЭтойБД" Тогда
		СвязатьЭлементСЭтойБДНаСервере(ВнешняяИБ);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
