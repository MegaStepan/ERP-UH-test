&НаКлиенте
Процедура СоздатьОбъектВЭтойБД(ВнешняяИБ)

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВыбраннаяВнешняяИБ", ВнешняяИБ);
	Если Строка(ТекущийПараметрОбменаНСИ) = "Контрагенты" Тогда 		
		РезультатПроверки = СоздатьОбъектВЭтойБД_Контрагенты_ПроверкаПередСозданием();
		Если РезультатПроверки.Отказ Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатПроверки.Сообщение, РезультатПроверки.НайденнаяСсылка);	
		Иначе 	
			ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьОбъектКонтрагентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ТекстВопроса = НСтр("ru = 'Создать Контрагента по данным этой БД?'");
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбъектКонтрагентЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СоздатьОбъектКонтрагентВЭтойБДНаСервере(ДополнительныеПараметры); 
		ЭтоВнешняяСсылка = Ложь;
		ОбъектТекущейИБПриИзмененииНаСервере();
		ОбновитьЗаголовокКнопкиСформироватьОтчет();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьОбъектВЭтойБД_Контрагенты_ПроверкаПередСозданием()

	РезультатПроверки = Новый Структура("Отказ, Сообщение, НайденнаяСсылка", Ложь);
	ДанныеВызова_Рек = ПолучитьИзВременногоХранилища(АдресДанныхОбъекта_Рек);
	Если ДанныеВызова_Рек = Неопределено ИЛИ ДанныеВызова_Рек[0].ПустойРезультат Тогда 
		РезультатПроверки.Отказ = Истина;
		РезультатПроверки.Сообщение = "В выбранной базе нет данных";
	Иначе 	
		НайденнаяСсылка = Справочники.Контрагенты.НайтиПоРеквизиту("НТ_КОД", ДанныеВызова_Рек[0].НТ_КОД);
		Если Не НайденнаяСсылка.Пустая() Тогда 
			РезультатПроверки.Отказ = Истина;
			РезультатПроверки.Сообщение = "Найден контрагент по коду: " + ДанныеВызова_Рек[0].НТ_КОД + " " + НайденнаяСсылка;
			РезультатПроверки.НайденнаяСсылка = НайденнаяСсылка;	
		КонецЕсли;
		Если ДанныеВызова_Рек[0].НТ_КОД <> ДанныеВызова_Рек[0].ГоловнойКонтрагент_НТ_КОД Тогда 
			НайденнаяСсылка = Справочники.Контрагенты.НайтиПоРеквизиту("НТ_КОД", ДанныеВызова_Рек[0].ГоловнойКонтрагент_НТ_КОД);
			Если НайденнаяСсылка.Пустая() Тогда 
				РезультатПроверки.Отказ = Истина;
				РезультатПроверки.Сообщение = "Не найден Головной контрагент по коду: " + ДанныеВызова_Рек[0].ГоловнойКонтрагент_НТ_КОД;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Процедура СвязатьЭлементСЭтойБДНаСервере(ВыбраннаяВнешняяИБ)

	ТекущаяИБ = ПолучитьВнешняяИБПоИмени("Текущая информационная база");
	ВнешниеБД_СнятьОтметитьВсе(Команды.ВнешниеБД_ОтменитьВсе, Ложь, ТекущаяИБ);
	СформироватьОтчет_ПоРеквизитам(Истина); // помещает данные заполнения во временное хранилище
	ДанныеВызова_Рек = ПолучитьИзВременногоХранилища(АдресДанныхОбъекта_Рек);
	
	Если ДанныеВызова_Рек[0].GUID = Неопределено Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Объект еще не создан в этой базе");	
	Иначе 	
		Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеВызова_Рек[0].GUID));
		ВнешниеБД_СнятьОтметитьВсе(Команды.ВнешниеБД_ОтменитьВсе, Ложь, ВыбраннаяВнешняяИБ);
		СформироватьОтчет_ПоРеквизитам(Истина); 

		ДанныеВызова_Рек = ПолучитьИзВременногоХранилища(АдресДанныхОбъекта_Рек); 
		Если ДанныеВызова_Рек[0].GUID = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не получилось получить данные из " + ВыбраннаяВнешняяИБ);	
		Иначе 	
			СоответствиеВнешнимИБ = ПолучитьЗначениеСоответствиеВнешнимИБ(ТекущийПараметрОбменаНСИ, ВыбраннаяВнешняяИБ.ТипБД);
			ИнтеграцияСВнешнимиСистемамиУХ.ЗаписатьСоответствиеОбъектовТекущейИВнешнейИБ(СоответствиеВнешнимИБ,
																ВыбраннаяВнешняяИБ,
																Ссылка,
																ДанныеВызова_Рек[0].GUID, //ДополнительныеПараметры.ОбъектВнешнейИБ
																ДанныеВызова_Рек[0].Наименование);	
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Связан объект с ID " + ДанныеВызова_Рек[0].GUID);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОбъектКонтрагентВЭтойБДНаСервере(ДополнительныеПараметры)

	ТекСоединениеВИБ = УправлениеСоединениямиВИБУХ.ПолучитьСоединение(ДополнительныеПараметры.ВыбраннаяВнешняяИБ, 1);		
	Если ТекСоединениеВИБ = Неопределено Тогда
		Сообщить("Ошибка соединения с базой " + ДополнительныеПараметры.ВыбраннаяВнешняяИБ); 
		Возврат;
	КонецЕсли;

	ДанныеВызова_Рек = ПолучитьИзВременногоХранилища(АдресДанныхОбъекта_Рек);
 	СоответствиеВнешнимИБ = ПолучитьЗначениеСоответствиеВнешнимИБ(ТекущийПараметрОбменаНСИ, ДополнительныеПараметры.ВыбраннаяВнешняяИБ.ТипБД);

	ДД = Справочники.Контрагенты.СоздатьЭлемент();	
	ЗаполнитьЗначенияСвойств(ДД, ДанныеВызова_Рек[0]);
	Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеВызова_Рек[0].GUID));
	ДД.УстановитьСсылкуНового(Ссылка);
	ДД.ГоловнойКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("НТ_КОД", ДанныеВызова_Рек[0].ГоловнойКонтрагент_НТ_КОД);
	Если ДанныеВызова_Рек[0].НТ_КОД = ДанныеВызова_Рек[0].ГоловнойКонтрагент_НТ_КОД Тогда 
		ДД.ГоловнойКонтрагент = Ссылка;
	КонецЕсли;	
	ДД.СтранаРегистрации = Справочники.СтраныМира.НайтиПоКоду(ДанныеВызова_Рек[0].СтранаРегистрации_Код); 
	Если ДанныеВызова_Рек[0].ЮридическоеФизическоеЛицо = "Юридическое лицо" Тогда
		ДД.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	ИначеЕсли ДанныеВызова_Рек[0].ЮридическоеФизическоеЛицо = "Юридическое лицо за пределами РФ" Тогда		
		ДД.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	Иначе 	
		ДД.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	КонецЕсли;
	ДД.РасширенноеПредставлениеИНН = ДД.ИНН;
	ДД.РасширенноеПредставлениеКПП = ДД.КПП;
	ДД.ИННВведенКорректно = Истина;
	ДД.КППВведенКорректно = Истина;
	ДД.ОбменДанными.Загрузка = Истина;
		
	ТаблицаСсылок = Новый ТаблицаЗначений();
	ТаблицаСсылок.Колонки.Добавить("Справочник_Контрагенты");
	ТаблицаСсылок.Колонки.Добавить("Справочник_КонтрагентыvzvЭлементСсылка");

	НН = ТаблицаСсылок.Добавить();
	НН.Справочник_Контрагенты = Неопределено;
	НН.Справочник_КонтрагентыvzvЭлементСсылка = ДанныеВызова_Рек[0].GUID;
	
	ТабСвязанныхОбъектов = ЗагрузитьДанныеСвязанныхОбъектов(ТекСоединениеВИБ, ТаблицаСсылок, СоответствиеВнешнимИБ, ДополнительныеПараметры.ВыбраннаяВнешняяИБ);
	
	Для Каждого т Из ТабСвязанныхОбъектов Цикл
		ДД[т.ИмяОбъектаТек].Загрузить(т.РабочаяТаблица);
	КонецЦикла;
	
	ТекстоваяСтрока = "#Загружено из " + ДополнительныеПараметры.ВыбраннаяВнешняяИБ + " " + ТекущаяДата();
	ЕстьСвойствоНТ_ИсточникДанных = Ложь;
	СвойствоНТ_ИсточникДанных = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("НТ_ИсточникДанных");
	НоваяСтрока = ДД.ДополнительныеРеквизиты.Добавить();
	НоваяСтрока.Свойство = СвойствоНТ_ИсточникДанных;
	НоваяСтрока.ТекстоваяСтрока = ТекстоваяСтрока;
	НоваяСтрока.Значение = ТекстоваяСтрока;
	
	ДД.Записать();
	ОбъектТекущейИБ = ДД.Ссылка;
	ИнтеграцияСВнешнимиСистемамиУХ.ЗаписатьСоответствиеОбъектовТекущейИВнешнейИБ(СоответствиеВнешнимИБ,
														ДополнительныеПараметры.ВыбраннаяВнешняяИБ,
														ДД.Ссылка,
														ДанныеВызова_Рек[0].GUID, //ДополнительныеПараметры.ОбъектВнешнейИБ
														ДанныеВызова_Рек[0].Наименование);
	ЗаполнитьСвязанныеРегистры(ТаблицаСсылок, ТабСвязанныхОбъектов);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстоваяСтрока , ДД.Ссылка);	
	
КонецПроцедуры 

Функция ЗагрузитьДанныеСвязанныхОбъектов(ТекСоединениеВИБ, Результат, ДанныеНастройки, ИспользуемаяИБ)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ТипОбъектаВИБ КАК ТипОбъектаВИБ,
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ТипОбъектаТек КАК ТипОбъектаТек,
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.НастройкаСоответствия КАК НастройкаСоответствия,
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ИзмерениеРегистраВИБ КАК ИзмерениеРегистраВИБ,
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ИзмерениеРегистраТек КАК ИзмерениеРегистраТек,
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.НастройкаСоответствия.ТаблицаАналитикиВИБ КАК ТаблицаАналитикиВИБ,
	             |	ВЫБОР
	             |		КОГДА СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаВИБ ССЫЛКА Справочник.ТабличныеЧастиБД
	             |			ТОГДА СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаВИБ.Имя
	             |		ИНАЧЕ СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаВИБ.Наименование
	             |	КОНЕЦ КАК ИмяОбъектаВИБ,
	             |	ВЫБОР
	             |		КОГДА СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаТек ССЫЛКА Справочник.ТабличныеЧастиБД
	             |			ТОГДА СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаТек.Имя
	             |		ИНАЧЕ СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.ОписаниеОбъектаТек.Наименование
	             |	КОНЕЦ КАК ИмяОбъектаТек
	             |ИЗ
	             |	Справочник.СоответствиеВнешнимИБ.СоответствияСвязанныхОбъектов КАК СоответствиеВнешнимИБСоответствияСвязанныхОбъектов
	             |ГДЕ
	             |	СоответствиеВнешнимИБСоответствияСвязанныхОбъектов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ДанныеНастройки.Ссылка); 
	
	ТабСвязанныхОбъектов=Запрос.Выполнить().Выгрузить();
	
	Если ТабСвязанныхОбъектов.Количество()=0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТабСвязанныхОбъектов.Колонки.Добавить("РабочаяТаблица");
	
	КодАналитики=СтрЗаменить(ДанныеНастройки.ТаблицаАналитикиВИБ,".","_");
	ПолеСсылка=КодАналитики+"vzvЭлементСсылка";
	
	ТаблицаСсылок=Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("GUIDВнешнейИБ");
	ТаблицаСсылок.Колонки.Добавить("СсылкаТекущейИБ"); 
	
	Для Каждого Строка ИЗ Результат Цикл 
		
		НоваяСтрока=ТаблицаСсылок.Добавить();
		НоваяСтрока.GUIDВнешнейИБ=Строка[ПолеСсылка];
		НоваяСтрока.СсылкаТекущейИБ=Строка[КодАналитики];
		
	КонецЦикла;
	
	МассивСсылокВИБ=ТаблицаСсылок.ВыгрузитьКолонку("GUIDВнешнейИБ");
	
	Для Каждого СтрокаНастройка ИЗ ТабСвязанныхОбъектов Цикл
		
		СтрокаНастройка.РабочаяТаблица=Импорт_ПолучитьРабочуюТаблицуСвязанныхОбъектов(ТекСоединениеВИБ,СтрокаНастройка,ДанныеНастройки.ТаблицаАналитикиВИБ,МассивСсылокВИБ,ИспользуемаяИБ);
		
	КонецЦикла;
	
	Возврат ТабСвязанныхОбъектов;
	
	
КонецФункции// ЗагрузитьДанныеСвязанныхОбъектов()

Функция Импорт_ПолучитьРабочуюТаблицуСвязанныхОбъектов(ТекСоединениеВИБ,СтрокаНастройка,ТаблицаАналитикиВИБ,МассивGUID,ИспользуемаяИБ)
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	СоответствиеВнешнимИБСоответствиеРеквизитов.РеквизитОбъектаКонсолидации КАК РеквизитОбъектаКонсолидации,
	|	СоответствиеВнешнимИБСоответствиеРеквизитов.РеквизитОбъектаВнешнейИБ КАК РеквизитОбъектаВнешнейИБ,
	|	СоответствиеВнешнимИБСоответствиеРеквизитов.СпособЗаполнения КАК СпособЗаполнения,
	|	СоответствиеВнешнимИБСоответствиеРеквизитов.ФиксированноеЗначение КАК ФиксированноеЗначение
	|ИЗ
	|	Справочник.СоответствиеВнешнимИБ.СоответствиеРеквизитов КАК СоответствиеВнешнимИБСоответствиеРеквизитов
	|ГДЕ
	|	СоответствиеВнешнимИБСоответствиеРеквизитов.Ссылка = &Ссылка
	|	И (НЕ СоответствиеВнешнимИБСоответствиеРеквизитов.РеквизитОбъектаВнешнейИБ = """"
	|			ИЛИ СоответствиеВнешнимИБСоответствиеРеквизитов.ФиксированноеЗначение = НЕОПРЕДЕЛЕНО)";
	
	ТаблицаПолей=Новый ТаблицаЗначений;
	ТаблицаПолей.Колонки.Добавить("ПолеБД");
	ТаблицаПолей.Колонки.Добавить("ПолеПриемник");
	
	ТаблицаЗаполнения=Новый ТаблицаЗначений;
	ТаблицаЗаполнения.Колонки.Добавить("ФиксированноеЗначение");
	ТаблицаЗаполнения.Колонки.Добавить("ПолеПриемник"); 
	
	МассивСинонимов=Новый Массив;
	
	Запрос.УстановитьПараметр("Ссылка", СтрокаНастройка.НастройкаСоответствия);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Результат.РеквизитОбъектаВнешнейИБ) Тогда
			
			Если МассивСинонимов.Найти(Результат.РеквизитОбъектаКонсолидации)=Неопределено Тогда
				
				НоваяСтрока=ТаблицаПолей.Добавить();
				НоваяСтрока.ПолеБД=ИнтеграцияСВнешнимиСистемамиУХ.УбратьПолеСсылка(Результат.РеквизитОбъектаВнешнейИБ);
				НоваяСтрока.ПолеПриемник=Результат.РеквизитОбъектаКонсолидации;
				
				МассивСинонимов.Добавить(Результат.РеквизитОбъектаКонсолидации);
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Результат.ФиксированноеЗначение) Тогда
			
			НоваяСтрока=ТаблицаЗаполнения.Добавить();
			НоваяСтрока.ФиксированноеЗначение=Результат.ФиксированноеЗначение;
			НоваяСтрока.ПолеПриемник=Результат.РеквизитОбъектаКонсолидации;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеВладельца=Новый Структура;
	ДанныеВладельца.Вставить("ТаблицаАналитикиВИБ",ТаблицаАналитикиВИБ);
	ДанныеВладельца.Вставить("МассивGUID",МассивGUID);
	
	ДанныеДляВыборки=Новый Структура;
	ДанныеДляВыборки.Вставить("ТаблицаАналитикиВИБ",?(СтрокаНастройка.ТипОбъектаВИБ="ТабличнаяЧасть",ТаблицаАналитикиВИБ+"."+СтрокаНастройка.ИмяОбъектаВИБ,СтрокаНастройка.ТаблицаАналитикиВИБ));
	ДанныеДляВыборки.Вставить("ПолеСсылка",?(СтрокаНастройка.ТипОбъектаВИБ="ТабличнаяЧасть","Ссылка",СтрокаНастройка.ИзмерениеРегистраВИБ));
	ДанныеДляВыборки.Вставить("ТаблицаПолей",ТаблицаПолей);	
	
	ДанныеТаблицы=ПолучитьДанныеСвязаннойТаблицыВИБ(ТекСоединениеВИБ,ДанныеВладельца,ДанныеДляВыборки);
	
	РабочаяТаблица=ОбменДаннымиНСИУХ.ПолучитьРабочуюТаблицуПоДаннымПереноса(ИспользуемаяИБ,ДанныеТаблицы);
	
	Для Каждого СтрокаЗаполнения ИЗ ТаблицаЗаполнения Цикл
		
		НоваяКолонка=РабочаяТаблица.Колонки.Добавить(СтрокаЗаполнения.ПолеПриемник);
		РабочаяТаблица.ЗаполнитьЗначения(СтрокаЗаполнения.ФиксированноеЗначение,СтрокаЗаполнения.ПолеПриемник);
		
	КонецЦикла;
	
	РабочаяТаблица.Колонки.Ссылка.Имя="_GUIDВнешнейИБ";
	
	Если РабочаяТаблица.Количество()>100 Тогда
		
		РабочаяТаблица.Индексы.Добавить("_GUIDВнешнейИБ");
		
	КонецЕсли;
	
	Возврат РабочаяТаблица;
		
КонецФункции // ПолучитьРабочуюТаблицу()

Функция ПолучитьДанныеСвязаннойТаблицыВИБ(ТекСоединениеВИБ,ДанныеВладельца,ДанныеДляВыборки) 
	
	СтруктураПараметров=Новый Структура;
	СтруктураПараметров.Вставить("ДанныеВладельца",ДанныеВладельца);
	СтруктураПараметров.Вставить("ДанныеДляВыборки",ДанныеДляВыборки);
	
	Если ТипЗнч(ТекСоединениеВИБ) = Тип("WSProxy") Тогда 
			
		Возврат ТекСоединениеВИБ.GetRelatedTableData(Новый ХранилищеЗначения(СтруктураПараметров, Новый СжатиеДанных(9))).Получить(); 
		
	ИначеЕсли ТипЗнч(ТекСоединениеВИБ) = Тип("Строка") Тогда
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.ПолучитьОтвет1СШина(ТекСоединениеВИБ,"GetRelatedTableData",СтруктураПараметров);
		
	Иначе
		
		Возврат РаботаСОбъектамиМетаданныхВнешнийУХ.GetRelatedTableData(ТекСоединениеВИБ,СтруктураПараметров);
		
	КонецЕсли;
	
	
КонецФункции // ПолучитьДанныеСвязаннойТаблицыВИБ()

Процедура ЗаполнитьСвязанныеРегистры(ТаблицаСсылок, ТабСвязанныхОбъектов)
	
	МассивРегистров=ТабСвязанныхОбъектов.НайтиСтроки(Новый Структура("ТипОбъектаТек","РегистрСведений"));
	
	Для Каждого СтрокаСсылка ИЗ ТаблицаСсылок Цикл 
		
		Для Каждого СтрокаРегистр ИЗ МассивРегистров Цикл 
			
			МассивСтрок=СтрокаРегистр.РабочаяТаблица.НайтиСтроки(Новый Структура("_GUIDВнешнейИБ",СтрокаСсылка.GUIDВнешнейИБ));
		
			Если МассивСтрок.Количество()>0 Тогда
				
		//		ЗаписатьДанныеРегистра(СтрокаСсылка.СсылкаТекущейИБ,СтрокаРегистр,МассивСтрок);
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЦикла;
		
КонецПроцедуры // ЗаполнитьСвязанныеРегистры() 

Процедура ЗаписатьДанныеРегистра(Ссылка,СтрокаРегистр,МассивСтрок)
	
	РабочийОбъект=РегистрыСведений[СтрокаРегистр.ИмяОбъектаТек].СоздатьНаборЗаписей();
	РабочийОбъект.Отбор[СтрокаРегистр.ИзмерениеРегистраТек].Установить(Ссылка);
	
	Для Каждого СтрокаЗаписи ИЗ МассивСтрок Цикл
		
		НоваяСтрока=РабочийОбъект.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаЗаписи);
		НоваяСтрока[СтрокаРегистр.ИзмерениеРегистраТек]=Ссылка;
		
	КонецЦикла; 
	
	Попытка
		
		РабочийОбъект.Записать(Истина);
		
	Исключение
		
		ТекстОшибки=ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения=СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru = 'Не удалось обновить данные связанного регистра %1 объекта %2:
		|%3'"),СтрокаРегистр.ИмяОбъектаТек,Ссылка,ТекстОшибки); 
			
		ОбщегоНазначенияУХ.СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Важное);
		
	КонецПопытки;	
	
КонецПроцедуры // ЗаписатьДанныеРегистра()  

#КонецОбласти