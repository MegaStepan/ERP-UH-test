#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыОбменаНСИ.Ссылка КАК Ссылка,
	|	Представление(ПараметрыОбменаНСИ.Ссылка) КАК Представление,
	|	ВЫБОР КОГДА ПараметрыОбменаНСИ.Отключен ТОГДА ""(отключен)"" ИНАЧЕ """" КОНЕЦ КАК Дополнение,
	|	ПараметрыОбменаНСИ.Отключен КАК Отключен
	|ИЗ
	|	Справочник.ПараметрыОбменаНСИ КАК ПараметрыОбменаНСИ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	""ДоговорыКонтрагентов"" КАК Ссылка,
	|	""Договоры"" КАК Представление,
	|	"""" КАК Дополнение,
	|	ИСТИНА КАК Отключен
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	""Пользователи"" КАК Ссылка,
	|	""Пользователи"" КАК Представление,
	|	"""" КАК Дополнение,
	|	ИСТИНА КАК Отключен
	|УПОРЯДОЧИТЬ ПО Отключен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВнешниеИнформационныеБазы.Ссылка = ЗНАЧЕНИЕ(Справочник.ВнешниеИнформационныеБазы.ТекущаяИБ) КАК Выбран,
	|	ВнешниеИнформационныеБазы.Ссылка = ЗНАЧЕНИЕ(Справочник.ВнешниеИнформационныеБазы.ТекущаяИБ) КАК ТекущаяИБ,
	|	ВнешниеИнформационныеБазы.Ссылка КАК ВнешняяИБ,
	|	ВнешниеИнформационныеБазы.ТипБД КАК ТипБД,
	|	ВнешниеИнформационныеБазы.ПутьКWebСервису КАК ПутьКWebСервису,
	|	ВнешниеИнформационныеБазыНТ_Организации.Организация КАК Организация
	|ИЗ
	|	Справочник.ВнешниеИнформационныеБазы КАК ВнешниеИнформационныеБазы
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВнешниеИнформационныеБазы.НТ_Организации КАК ВнешниеИнформационныеБазыНТ_Организации
	|		ПО ВнешниеИнформационныеБазыНТ_Организации.Ссылка = ВнешниеИнформационныеБазы.Ссылка
	|ГДЕ
	|	ВнешниеИнформационныеБазы.Ссылка.ИспользоватьWS = ИСТИНА
	|	И ВнешниеИнформационныеБазы.Ссылка.ПометкаУдаления = ЛОЖЬ 
	|УПОРЯДОЧИТЬ ПО Выбран Убыв, Организация Убыв";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ЗначенияНаправлениеОбмена = ПакетЗапросов[0].Выбрать();
	Пока ЗначенияНаправлениеОбмена.Следующий() Цикл 
		Элементы.ИмяСправочника.СписокВыбора.Добавить(ЗначенияНаправлениеОбмена.Ссылка, ЗначенияНаправлениеОбмена.Представление + " " + ЗначенияНаправлениеОбмена.Дополнение);
	КонецЦикла;	
	
	СписокВнешнихИнформационныхБаз.Загрузить(ПакетЗапросов[1].Выгрузить());
	УстановитьУсловноеОформление();	
	НастройкаВыводитьТабличныеЧасти = Истина;
	
КонецПроцедуры 

