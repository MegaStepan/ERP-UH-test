&НаКлиенте
Процедура НайтиОбъектПоURL(Команда)
	Если ПустаяСтрока(_URL) Тогда 
		Возврат;
	КонецЕсли;	
	ОбъектТекущейИБ = вНайтиОбъектПоURL(_URL);		
	Если ОбъектТекущейИБ = Неопределено ИЛИ СтрЧислоВхождений(Строка(ОбъектТекущейИБ), "не найден") = 1 Тогда
		Элементы.НайтиОбъектПоURL.ЦветФона = WebЦвета.СветлоРозовый;
	Иначе 	
		Элементы.НайтиОбъектПоURL.ЦветФона = WebЦвета.СветлоЗеленый;
	КонецЕсли;
	Если ОбъектТекущейИБ <> Неопределено И СтрЧислоВхождений(Строка(ОбъектТекущейИБ), "не найден") = 0 Тогда 
		//Объект найден по навигационной ссылке 
		ТипЗнчЭлемент = ТипЗнч(ОбъектТекущейИБ);
		Элементы.ОбъектТекущейИБ.ОграничениеТипа = вСоздатьОписаниеТипов(ТипЗнчЭлемент);
		ОбновитьИмяСправочникаПоВыбранномуОбъектТекущейИБ();
		ОбновитьТаблицаПравилИспользованияПолей(); /////////////
		ОбновитьКлючевыеПолеПоиска();
		ОбъектТекущейИБПриИзмененииНаСервере();
		ЭтоВнешняяСсылка = Ложь;
	ИначеЕсли ЭтоВнешняяСсылка Тогда  
		//Объект не найден по внешней ссылке, но можно определенить тип объекта
		Если СтрЧислоВхождений(_URL, "Контрагенты") = 1 Тогда  
			ОбъектТекущейИБ = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
			ТипЗнчЭлемент = ТипЗнч(ОбъектТекущейИБ);
			Элементы.ОбъектТекущейИБ.ОграничениеТипа = вСоздатьОписаниеТипов(ТипЗнчЭлемент);
		ИначеЕсли СтрЧислоВхождений(_URL, "КонтактныеЛица") = 1 Тогда  
			ОбъектТекущейИБ = ПредопределенноеЗначение("Справочник.КонтактныеЛица.ПустаяСсылка");
			ТипЗнчЭлемент = ТипЗнч(ОбъектТекущейИБ);
			Элементы.ОбъектТекущейИБ.ОграничениеТипа = вСоздатьОписаниеТипов(ТипЗнчЭлемент);
        КонецЕсли;
		ОбновитьИмяСправочникаПоВыбранномуОбъектТекущейИБ();
	КонецЕсли;
	
	ВыбраннаяВнешняяИБ = Неопределено;
	СтрокаПоискаВнешнейБД  = СтрРазделить(_URL, "#", Ложь);
	Если СтрокаПоискаВнешнейБД.Количество() > 1 Тогда 
		СтрокаПоискаВнешнейБД  = СтрРазделить(СтрокаПоискаВнешнейБД[0], "/");
		СтрокаПоискаВнешнейБД = СтрокаПоискаВнешнейБД[4];			
		ВыбратьВнешняяИБВСпискеПоСтроке(СтрокаПоискаВнешнейБД, ВыбраннаяВнешняяИБ);
		Если ВыбраннаяВнешняяИБ = Неопределено Тогда //вторая попытка поиска
			//путь публикации web сервиса и путь внешней ссылки не всегда совпадают, поэтому некоторые пути прописаны в коде
			Если СтрЧислоВхождений(СтрокаПоискаВнешнейБД, "1C_MSK_GCNVT_DOC") = 1 ИЛИ СтрЧислоВхождений(СтрокаПоискаВнешнейБД, "1C_DOC_i_stepanov") = 1 Тогда
				СтрокаПоискаВнешнейБД = "s1c-01-msk.hcnvt.ru/edo";
			КонецЕсли;			
			ВыбратьВнешняяИБВСпискеПоСтроке(СтрокаПоискаВнешнейБД, ВыбраннаяВнешняяИБ);
		КонецЕсли;	
	КонецЕсли;
	
	ОбновитьЗаголовокКнопкиСформироватьОтчет();
    НастройкаРежимПоискаПоРевизитам = Ложь;
	ОбновитьТаблицаПравилИспользованияПолей();
	НастройкаРежимПоискаПоРевизитамПриИзменении(Элементы._URL);

	Если кешИмяОбъектаМетаданных = "Контрагенты" И ЭтоВнешняяСсылка И ВыбраннаяВнешняяИБ <> Неопределено Тогда 		
		СформироватьОтчет(Команды.СформироватьОтчет); // запускает сценарий получения данных по ссылке, заполнения ключевых полей, поиска по ключемым полям по всем базам 
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыбратьВнешняяИБВСпискеПоСтроке(СтрокаПоискаВнешнейБД, ВыбраннаяВнешняяИБ)
	мИдентификаторСтроки = 0;
	Для Каждого м Из СписокВнешнихИнформационныхБаз Цикл 
		м.Выбран = Ложь;
		Если м.ТекущаяИБ И (ОбъектТекущейИБ <> Неопределено И Не ОбъектТекущейИБ.пустая()) Тогда 
			м.Выбран = Истина;	
		КонецЕсли;	
		Если СтрЧислоВхождений(м.ПутьКWebСервису, СтрокаПоискаВнешнейБД) = 1 Тогда 
			м.Выбран = Истина;	
			мИдентификаторСтроки = м.ПолучитьИдентификатор();
			ВыбраннаяВнешняяИБ = м.ВнешняяИБ;
		КонецЕсли;	
	КонецЦикла;
	Элементы.СписокВнешнихИнформационныхБаз.ТекущаяСтрока = мИдентификаторСтроки;
КонецПроцедуры

&НаСервере
Процедура ОбновитьИмяСправочникаПоВыбранномуОбъектТекущейИБ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПараметрыОбменаНСИ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПараметрыОбменаНСИ КАК ПараметрыОбменаНСИ
		|ГДЕ
		|	ПараметрыОбменаНСИ.ОписаниеОбъектаМетаданных.ИмяОбъектаМетаданных = &ИмяОбъектаМетаданных";
	
	Запрос.УстановитьПараметр("ИмяОбъектаМетаданных", ОбъектТекущейИБ.Метаданные().Имя);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущийПараметрОбменаНСИ = ВыборкаДетальныеЗаписи.Ссылка; 
		кешИмяОбъектаМетаданных = ТекущийПараметрОбменаНСИ.ОписаниеОбъектаМетаданных.ИмяОбъектаМетаданных;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция вСоздатьОписаниеТипов(Знач пТип)
	пМассив = новый Массив;
	пМассив.Добавить(пТип);	
	Возврат новый ОписаниеТипов(пМассив);
КонецФункции

Функция вНайтиОбъектПоURL(Знач URL)
	
	Поз1 = Найти(URL, "e1cib/data/");
    Поз2 = Найти(URL, "?ref=");
	
	Если Поз1 = 0 или Поз2 = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоВнешняяСсылка Тогда                     
		GUIDвнешнейСсылки = ПолучитьGUIDПоНавигационнойСсылке(Сред(URL, Поз2 + 5));
		Результат = ПолучитьОбъектОбъектТекущейИБпоСсылкеВнешнейИБ(GUIDвнешнейСсылки);
		Возврат Результат.ОбъектТекущейИБ;
	КонецЕсли;	
	
	Попытка
	    ИмяТипа = Сред(URL, Поз1 + 11, Поз2 - Поз1 - 11);
	    ШаблонЗначения = ЗначениеВСтрокуВнутр(ПредопределенноеЗначение(ИмяТипа + ".ПустаяСсылка"));
	    ЗначениеСсылки = СтрЗаменить(ШаблонЗначения, "00000000000000000000000000000000", Сред(URL, Поз2 + 5));
	    Ссылка = ЗначениеИзСтрокиВнутр(ЗначениеСсылки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Ссылка;
	
КонецФункции 

Функция ПолучитьGUIDПоНавигационнойСсылке(НавигационнаяСсылка)
	Стр = Прав(НавигационнаяСсылка, 32);
	ЧастиУИД = Новый Массив;
	ЧастиУИД.Добавить(Прав(Стр, 8));
	ЧастиУИД.Добавить(Сред(Стр, 21, 4));
	ЧастиУИД.Добавить(Сред(Стр, 17, 4));
	ЧастиУИД.Добавить(Лев(Стр, 4));
	ЧастиУИД.Добавить(Сред(Стр, 5, 12));
	СтрокаУИД = СтрСоединить(ЧастиУИД, "-");
	Возврат СтрокаУИД;
КонецФункции   

Функция ПолучитьНавигационнуюСсылкуПоGUID(GUID)
	НавигационнаяСсылка = Сред(GUID, 20, 4) + Прав(GUID, 12) + Сред(GUID, 15, 4) + Сред(GUID, 10, 4) + Лев(GUID, 8);
	Возврат НавигационнаяСсылка;
КонецФункции

Процедура ДобавитьПолеВТаблицуПолей(ТаблицаПолей, ПутьКДанным, ИмяПоля)
	
	НоваяСтрока             = ТаблицаПолей.Добавить();
	НоваяСтрока.ИмяПоля     = ИмяПоля;
	НоваяСтрока.ПутьКДанным = ПутьКДанным;
	
КонецПроцедуры

