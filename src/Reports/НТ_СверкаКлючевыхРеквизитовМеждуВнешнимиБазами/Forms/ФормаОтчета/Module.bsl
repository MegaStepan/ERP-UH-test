&НаСервере
Процедура ИмяСправочникаПриИзмененииНаСервере()
	
	СписокТипов = Новый Массив;
	Если ТипЗнч(ТекущийПараметрОбменаНСИ) = Тип("Строка") Тогда 
		СписокТипов.Добавить(Тип("СправочникСсылка." + ТекущийПараметрОбменаНСИ));
	Иначе 	
		СписокТипов.Добавить(Тип("СправочникСсылка." + ТекущийПараметрОбменаНСИ.ОписаниеОбъектаМетаданных.ИмяОбъектаМетаданных));
	КонецЕсли;	
	ОписаниеТипа = Новый ОписаниеТипов(СписокТипов); 
	Элементы.ОбъектТекущейИБ.ОграничениеТипа = ОписаниеТипа; 
//	Элементы.ГруппаСоздатьОбъект.Видимость = Ложь;
	кешИмяОбъектаМетаданных = ТекущийПараметрОбменаНСИ.ОписаниеОбъектаМетаданных.ИмяОбъектаМетаданных;
	
КонецПроцедуры

