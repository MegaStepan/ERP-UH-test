#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	
	ТекущиеДанные = Элементы.СписокВнешнихИнформационныхБаз.ТекущиеДанные;

	Если Не ЗначениеЗаполнено(ТекущийПараметрОбменаНСИ) Тогда 
		ПоказатьПредупреждение(, "Не выбран ""Тип объекта""");
		Возврат;
	КонецЕсли;	
	мВыбран = СписокВнешнихИнформационныхБаз.НайтиСтроки(Новый Структура("Выбран", Истина));
	Если мВыбран.Количество() = 0 Тогда 
		Сообщить("Не выбрана внешняя ИБ для получения данных по внешней ссылке");
		Возврат;
	ИначеЕсли ЭтоВнешняяСсылка И мВыбран.Количество() > 1 Тогда //Не НастройкаРежимПоискаПоРевизитам И 
		Сообщить("Должна быть выбрана только одна ИБ, для получения данных по внешней ссылке");
		Возврат;
	КонецЕсли;	
	
	Если НастройкаРежимПоискаПоРевизитам Тогда
		КоличествоЗаполненных = 0;
		Для Каждого Элемент Из СписокКлючевыхРеквизитов Цикл 
			Если Не ПустаяСтрока(ЭтотОбъект[Элемент.Значение]) Тогда
				КоличествоЗаполненных = КоличествоЗаполненных + 1;
			КонецЕсли;
		КонецЦикла; 
		Если КоличествоЗаполненных = 0 Тогда 
			Сообщить("Не заполнены ключевые поля поиска");
			Возврат;
		КонецЕсли;	
	КонецЕсли;

	НайденОбъектВнешнейБДПоСсылке = Ложь;
	
	Если ЗначениеЗаполнено(ОбъектТекущейИБ) ИЛИ НастройкаРежимПоискаПоРевизитам Тогда 
		СформироватьОтчет_ПоРеквизитам(); 
	ИначеЕсли ЭтоВнешняяСсылка И Не ТекущиеДанные = Неопределено Тогда 	
		СформироватьОтчет_ПоGUID(ТекущиеДанные.ВнешняяИБ, ,НайденОбъектВнешнейБДПоСсылке); 
	ИначеЕсли Не ЭтоВнешняяСсылка Тогда 
		Сообщить("Не выбран Объект текущей ИБ");
	КонецЕсли;	
	
	Если ЭтоВнешняяСсылка И НайденОбъектВнешнейБДПоСсылке Тогда 
		НастройкаРежимПоискаПоРевизитам = Истина;
		НастройкаРежимПоискаПоРевизитамПриИзменении(Элементы._URL); 
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьСценарийПоискаИсточникаСозданияКонтрагента", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Выполнить поиск объекта во всех базах по ключемым реквизитам?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;	


КонецПроцедуры

